material {
    name : ForestEffects,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    culling : none,
    requires : [ uv0, color ],
    constants : [ { type : int, name : kind, default : 0 } ],
    parameters : [ { type : float, name : time, precision : high } ]
}
fragment {
    // Integer mixing keeps the fractional noise alive on FP16 mobile GPUs.
    highp float hash(highp vec2 p) {
        highp ivec2 cell=ivec2(p);
        highp uvec2 q=uvec2(cell);
        highp uint bits=q.x*0x9e3779b9u ^ q.y*0x85ebca6bu;
        bits ^= bits >> 16u;
        bits *= 0x7feb352du;
        bits ^= bits >> 15u;
        bits *= 0x846ca68bu;
        bits ^= bits >> 16u;
        return float(bits >> 8u)*(1.0/16777216.0);
    }
    highp float noise(highp vec2 p) {
        highp vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);
        return mix(mix(hash(i),hash(i+vec2(1,0)),f.x),mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x),f.y);
    }
    highp float turbulence(highp vec2 p) {
        return noise(p)*0.57+noise(p*2.03+7.0)*0.28+noise(p*4.11)*0.15;
    }
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 uv=getUV0(),p=uv*2.0-1.0;
        highp vec4 tint=getColor();
        if(tint.a<0.003) discard;
        highp float mask=0.0;
        highp float emission=0.0;
        highp vec3 color=tint.rgb;
        if(materialConstants_kind==0) {
            highp float taper=1.0-uv.y*0.65;
            highp float envelope=1.0-smoothstep(0.15,1.0,length(vec2(p.x/taper,p.y)));
            if(envelope*tint.a<0.003) discard;
            highp float n=turbulence(uv*vec2(4,5)-vec2(0,materialParams.time*2.8));
            mask=envelope*smoothstep(0.15,0.65,n);
            emission=48000.0;
        } else if(materialConstants_kind==1) {
            highp float envelope=1.0-smoothstep(0.35,1.0,length(p));
            if(envelope*tint.a<0.003) discard;
            highp float n=turbulence(uv*5.0-vec2(materialParams.time*0.6));
            mask=envelope*smoothstep(0.1,0.7,n);
            color*=mix(0.35,1.0,n);
            emission=60000.0;
        } else if(materialConstants_kind==2) {
            mask=1.0-smoothstep(0.15,1.0,length(p));
        } else if(materialConstants_kind==3) {
            highp float core=1.0-smoothstep(0.03,0.18,abs(p.x));
            mask=exp(-abs(p.x)*4.0);
            color=mix(color,vec3(0.92,0.96,1.0),core);
            emission=280000.0*(0.3+core*0.7);
        } else {
            highp float envelope=1.0-smoothstep(0.25,1.0,length(p));
            if(envelope*tint.a<0.003) discard;
            highp float n=turbulence(uv*4.0+vec2(materialParams.time*0.12,-materialParams.time*0.2));
            mask=envelope*smoothstep(0.12,0.7,n);
            color*=0.5+0.9*n+0.25*uv.y;
        }
        highp float alpha=clamp(mask*tint.a,0.0,1.0);
        if(alpha<0.003) discard;
        material.baseColor=vec4(emission>0.0?vec3(0.0):color*alpha,alpha);
        // Apply exposure before storing in MaterialInputs' mediump emissive field.
        // Exposure weight zero tells Filament the value is already exposed.
        highp vec3 exposed=color*(emission*alpha*getExposure());
        material.emissive=vec4(exposed,0.0);
    }
}
